{
 "doctype": "DocType",
 "name": "SK Work Log",
 "module": "SK App",
 "custom": 0,
 "engine": "InnoDB",
 "creation": "2026-10-25 08:30:00.000000",
 "modified": "2026-10-25 08:30:00.000000",
 "owner": "Administrator",
 "modified_by": "Administrator",
 "naming_rule": "Expression",
 "track_changes": 1,
 "sort_field": "creation",
 "sort_order": "DESC",
 "field_order": [
  "user",
  "date",
  "entry_type",
  "problem_type",
  "description",
  "column_1",
  "reference_doctype",
  "reference_name",
  "assigned_to",
  "status",
  "photo"
 ],
 "fields": [
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "User",
   "options": "User",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "date",
   "fieldtype": "Date",
   "label": "Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "entry_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Extra Work\nTask Update\nProblem\nHandoff",
   "default": "Extra Work",
   "in_list_view": 1
  },
  {
   "fieldname": "problem_type",
   "fieldtype": "Select",
   "label": "Problem Type",
   "depends_on": "eval:doc.entry_type=='Problem'",
   "options": "\nMachine breakdown\nMaterial shortage\nQuality issue\nSafety\nCustomer complaint\nIT / app\nLeave\nPay / leave\nOther"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "What",
   "reqd": 1
  },
  {
   "fieldname": "column_1",
   "fieldtype": "Column Break",
   "label": "Column 1"
  },
  {
   "fieldname": "reference_doctype",
   "fieldtype": "Link",
   "label": "Reference Type",
   "options": "DocType"
  },
  {
   "fieldname": "reference_name",
   "fieldtype": "Dynamic Link",
   "label": "Reference",
   "options": "reference_doctype"
  },
  {
   "fieldname": "assigned_to",
   "fieldtype": "Link",
   "label": "Hand Off To",
   "options": "User"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Open\nDone\nAcknowledged",
   "default": "Open",
   "in_list_view": 1
  },
  {
   "fieldname": "photo",
   "fieldtype": "Attach Image",
   "label": "Photo"
  }
 ],
 "permissions": [
